    {
      "parameters": {
        "jsCode": "// Persist the newest timestamp we saw this run so next poll only fetches fresh stars.\nconst staticData = $getWorkflowStaticData('global');\nconst items = $items('Parse Stargazers + Rate Headers');\n\nif (items.length > 0) {\n  const timestamps = items.map(i => new Date(i.json.starred_at).getTime());\n  const maxTs = Math.max(...timestamps);\n  staticData.lastCheckedTimestamp = new Date(maxTs).toISOString();\n}\n\nreturn [{ json: { updated: true, newTimestamp: staticData.lastCheckedTimestamp } }];"
      },
      "id": "a76152f0-9fd7-46e9-bcca-45b629d430bd",
      "name": "Save Last Checked Timestamp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        -112
      ]
    }

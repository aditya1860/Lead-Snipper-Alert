      ],
      "notes": "Set SLACK_WEBHOOK_URL in n8n environment variables.",
      "notesInFlow": true
    },
    {
      "parameters": {},
      "id": "32df6f84-0286-4853-84db-aaf77cda9806",
      "name": "Skip (Low Value)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        -432,
        16
